# Consumed at build time by the Secrets Gradle Plugin, exposed as
# BuildConfig.<KEY>. Copy to `.env` (gitignored) and fill in real values.

# GEMINI_API_KEY: only needed if the app calls the Gemini API directly.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Notion — direct API integration (see data/notion/NotionConfig.kt).
# Internal-integration token from https://www.notion.so/my-integrations
NOTION_INTEGRATION_SECRET=ntn_xxx

# Ultimate Brain data-source IDs (run the repo-root setup_dev.py to discover).
UB_TASKS_DS_ID=
UB_PROJECTS_DS_ID=
UB_NOTES_DS_ID=
UB_TAGS_DS_ID=
UB_GOALS_DS_ID=
UB_MILESTONES_DS_ID=
UB_WORK_SESSIONS_DS_ID=
UB_PEOPLE_DS_ID=
UB_BOOKS_DS_ID=
UB_READING_LOG_DS_ID=
UB_GENRES_DS_ID=
UB_RECIPES_DS_ID=
UB_MEAL_PLANNER_DS_ID=
